
{
  "version": 2,
  "framework": null,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/index.tsx",
      "destination": "/index.tsx"
    },
    {
      "source": "/(.*)\\.(tsx|ts|js|json|css|png|jpg|svg|webp)",
      "destination": "/$1.$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(tsx|ts)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
