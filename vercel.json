
{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/index.tsx",
      "destination": "/index.tsx"
    },
    {
      "source": "/(App|constants|types|translations).(tsx|ts)",
      "destination": "/$1.$2"
    },
    {
      "source": "/lib/(.*).(tsx|ts)",
      "destination": "/lib/$1.$2"
    },
    {
      "source": "/components/(.*).(tsx|ts)",
      "destination": "/components/$1.$2"
    },
    {
      "source": "/pages/(.*).(tsx|ts)",
      "destination": "/pages/$1.$2"
    },
    {
      "source": "/(.*)\\.(js|json|css|png|jpg|svg|webp|webm)",
      "destination": "/$1.$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*).(tsx|ts)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
